# Three listeners = three security postures, all on localhost only.
# @ROOT@ is substituted by run_demo.py.
per_listener_settings true
log_type error
log_type warning

# 1) Plaintext, anonymous: the vulnerable baseline.
listener 1883 127.0.0.1
allow_anonymous true

# 2) TLS (server auth only): encrypts traffic, but any client may connect.
listener 8884 127.0.0.1
allow_anonymous true
cafile @ROOT@/certs/ca.crt
certfile @ROOT@/certs/broker.crt
keyfile @ROOT@/certs/broker.key
tls_version tlsv1.2

# 3) mTLS + ACL: clients must present a CA-signed cert; the cert CN becomes the
#    username, and the ACL pins each device to its own topic.
listener 8883 127.0.0.1
allow_anonymous false
require_certificate true
use_identity_as_username true
cafile @ROOT@/certs/ca.crt
certfile @ROOT@/certs/broker.crt
keyfile @ROOT@/certs/broker.key
tls_version tlsv1.2
acl_file @ROOT@/broker/acl.conf
